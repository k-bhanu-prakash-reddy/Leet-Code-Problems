class Solution:
    def pivotIndex(self, nums: List[int]) -> int:
        left = 0
        right = len(nums) -1
        TS =0
        SS = 0
        PS= 0
        for i in range(len(nums)) :
            TS +=nums[i]
        for i in range(len(nums)) :
            PS +=nums[i-1]
            SS =  TS - PS
            if SS == PS :
                if i==0:
                    return 0
                else:
                    return i+1
        return -1           
