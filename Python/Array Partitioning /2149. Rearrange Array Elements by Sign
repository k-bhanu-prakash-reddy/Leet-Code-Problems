class Solution:
    def rearrangeArray(self, nums: List[int]) -> List[int]:
        freq=[0]*len(nums) 
        left = 0
        temp=0
        temp1=0
        right =0
        while left<len(nums) :
            if nums[left] > 0 :
                freq[2*temp]= nums[left]
                temp +=1

            left +=1
        while right<len(nums) :
            if nums[right] < 0:
                freq[2*temp1+1] = nums[right]
                temp1 +=1
            right +=1
        return freq             

