class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        m = len(matrix)
        n = len(matrix[0])
        rows = [0]*m
        columns = [0]*n
        for i in range(m) :
            for j in range(n) :
                if matrix[i][j] == 0 :
                    rows[i] = 1
                    columns[j] = 1
        for i in range(m) :
            for j in range(n) :
                if rows[i] == 1 or columns[j] :
                    matrix[i][j] = 0
                                 
