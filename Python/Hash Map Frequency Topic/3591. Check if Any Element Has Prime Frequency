class Solution:
    def checkPrimeFrequency(self, nums: List[int]) -> bool:

        count = Counter(nums) 
        count1 =0    
        for key,value in count.items() :
            for i in range(1,len(nums)+1) :
                if value % i == 0 :
                    count1 +=1
            if count1 == 2 :
                return True
            count1 = 0      
        return False  
