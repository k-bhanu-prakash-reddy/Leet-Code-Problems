class Solution:
    def majorityElement(self, nums: List[int]) -> List[int]:
        freq = {}
        result = []
        n = len(nums)
        for num in nums :
            if num in freq :
                freq[num] +=1
            else :
                freq[num] =1
        for key,value in freq.items() :
            if value > n/3 :
                result.append(key)
        return result         

                
