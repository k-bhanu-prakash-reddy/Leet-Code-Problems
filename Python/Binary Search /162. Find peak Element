class Solution:
    def findPeakElement(self, nums: List[int]) -> int:
        maximum = float("-inf")
        summ =0
        for i in range(len(nums)) :
            if nums[i] > maximum :
                summ = i
            maximum = max(maximum,nums[i])    
        return summ

** binary search format **
class Solution:
    def findPeakElement(self, nums: List[int]) -> int:
        left = 0
        right = len(nums) - 1

        while left < right :
            mid = left+(right - left ) // 2
            if nums[mid] < nums[mid+1] :
                left = mid+1
            else :
                right = mid
        return left        

