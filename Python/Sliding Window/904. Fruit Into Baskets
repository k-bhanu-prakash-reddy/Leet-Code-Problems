class Solution:
    def totalFruit(self, fruits: List[int]) ->int :
        freq = {}
        left = 0 
        maximum = 0
        count = 0
        for i in range(len(fruits)) :
            if fruits[i] in freq :
                freq[fruits[i]] +=1
            else :
                freq[fruits[i]] = 1

            while len(freq) > 2 :
                freq[fruits[left]] -= 1

                if freq[fruits[left]] == 0 :
                    del freq[fruits[left]]
                left +=1
            count = i-left+1
            maximum = max(maximum,count)
        return maximum        
