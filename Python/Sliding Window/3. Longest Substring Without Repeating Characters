class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        left = 0
        ans = set()
        maximum = 0
        for i in range(len(s)) :
            while s[i] in ans :
                ans.remove(s[left])
                left +=1
            ans.add(s[i])
            count = i-left+1
            maximum = max(maximum,count)
        return maximum    
