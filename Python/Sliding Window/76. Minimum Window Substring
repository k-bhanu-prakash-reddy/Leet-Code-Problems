class Solution:
    def minWindow(self, s: str, t: str) -> str:
        need = {}
        for i in range(len(t)) :
            if t[i] in need :
                need[t[i]] += 1
            else :
                need[t[i]] = 1
        freq = {}
        minimum = float("inf")
        left = 0
        count = 0
        start = 0
        for right in range(len(s)) :
            if s[right] in freq :
                freq[s[right]] +=1
            else :
                freq[s[right]] = 1
            if s[right] in need  and freq[s[right]] <= need[s[right]] :
                count +=1
            while count == len(t) :
                if right - left + 1 < minimum :
                    minimum = right-left + 1
                    start = left
                freq[s[left]] -= 1
                if s[left] in need and freq[s[left]] < need[s[left]] :
                    count -= 1
                left += 1
        if minimum == float("inf") :
            return ""
        return s[start:start+minimum] 
