class Solution:
    def longestOnes(self, nums: List[int], k: int) -> int:
        count = 0 
        maximum = 0
        k1 = 0
        maximum = 0
        left = 0
        for i in range(len(nums)) :
            if nums[i] == 0 :
                k1 +=1
            
            while k1 > k :
                if nums[left] == 0 :
                    k1 -=1
                left +=1
            count = i - left + 1
            maximum = max(maximum,count)
        return maximum 
