class Solution:
    def check(self, nums: List[int]) -> bool:
        count=0
        maximum =nums[0]
        for i in range(1,len(nums)) :
            
           
            if nums[i] < maximum :
                count +=1
                maximum = nums[i]
                
            else :
                maximum = nums[i]
        if nums[len(nums)-1] > nums[0]  :
            count +=1
        if count >1 :
            return False         
                
         

        return True 
